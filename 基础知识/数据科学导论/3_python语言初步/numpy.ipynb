   ],
   "source": [
    "import numpy as np\n",
    "l = np.arange(1,11).reshape([2,-1])\n",
    "print(l)\n",
    "# print(np.sin(l))\n",
    "# print(np.exp(l))\n",
    "print(np.mean(l))   #均值\n",
    "print(np.median(l)) #中位数\n",
    "print(np.ptp(l))    #极差\n",
    "print(np.var(l))    #方差\n",
    "print(np.std(l))    #标准差\n"
   ]
  }
 ],
