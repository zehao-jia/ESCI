        # CBR
        x = self.cbr(x)
        
        # 转换为 (B, H, W, C) 用于空间Mamba
        x = x.permute(0, 2, 3, 1)  # (B, H, W, C)
        
        # 空间Mamba
        x = self.spatial_mamba(x)  # 返回 (B, C, H, W)
        
        # 光谱Mamba生成权重
        spectral_weights = self.spectral_mamba(high_freq_feat)  # (B, C, H, W)
        
        # 广播机制哈达玛积（逐元素相乘）
        x = x * spectral_weights
        
        # 残差连接
        out = x + residual
        
        return out


class BProcess(nn.Module):
    """
    B处理模块：对三个高频子带进行concat并使用一个1×1卷积得到输出的特征图
    完善版本：卷积后加入LayerNorm和ReLU，并加入残差连接
    """
    def __init__(self, dim):
        super().__init__()
        self.dim = dim
        # 三个高频子带concat后通道数为3*dim，用1x1卷积降维到dim
        self.conv1x1 = nn.Conv2d(3 * dim, dim, kernel_size=1, bias=False)
        
        # LayerNorm（需要转换为(B, H, W, C)格式）
        self.ln = nn.LayerNorm(dim)
        
        # ReLU激活函数
        self.relu = nn.ReLU(inplace=True)
        
        # 残差连接的投影层（用于将输入投影到相同维度）
        # 由于输入是三个子带的平均值或其中一个，我们需要一个投影层
        self.residual_proj = nn.Conv2d(dim, dim, kernel_size=1, bias=False)
    
    def forward(self, x_HL, x_LH, x_HH):
        """
        Args:
            x_HL: (B, C, H, W) - 高频子带HL
            x_LH: (B, C, H, W) - 高频子带LH
            x_HH: (B, C, H, W) - 高频子带HH
        Returns:
            out: (B, C, H, W) - 融合后的高频特征
        """
        # 保存残差连接的输入（使用三个子带的平均值）
        residual = (x_HL + x_LH + x_HH) / 3.0  # (B, C, H, W)
        
        # Concat三个高频子带
        x_concat = torch.cat([x_HL, x_LH, x_HH], dim=1)  # (B, 3*C, H, W)
        
        # 1x1卷积降维
        out = self.conv1x1(x_concat)  # (B, C, H, W)
        
        # LayerNorm（需要转换为(B, H, W, C)格式）
        out = out.permute(0, 2, 3, 1)  # (B, H, W, C)
        out = self.ln(out)
        out = out.permute(0, 3, 1, 2)  # (B, C, H, W)
        
        # ReLU激活
        out = self.relu(out)
        
        # 残差连接：投影残差输入并相加
        residual_proj = self.residual_proj(residual)  # (B, C, H, W)
        out = out + residual_proj
        
        return out




class MultiScaleConvModule(nn.Module):
    """
    多尺度卷积模块 (MetaFormer结构)：
    输入特征图 → LayerNorm → TopK Attention Token Mixer → 残差连接 → 
    LayerNorm → Channel Mixer (MLP) → 残差连接
    改进：将多尺度卷积部分替换为TopK Attention
    """

    def __init__(self, in_channels, input_resolution=32):
        super(MultiScaleConvModule, self).__init__()
        
        # LayerNorm 1 (用于Token Mixer前)
        self.norm1 = nn.LayerNorm(in_channels)
        
        # Token Mixer: TopK Attention（替代原来的多尺度卷积）
        self.topk_attention = TransformerAttention(
            in_channels=in_channels,
            input_resolution=input_resolution,
            num_heads=max(1, in_channels // 32),  # 每个head 32维，至少1个头
            win_size=8,
            shift_size=0,
            mlp_ratio=4.,
            token_mlp='leff'
        )
        self.topk_norm = nn.InstanceNorm2d(in_channels, affine=True)
        self.topk_relu = nn.ReLU(inplace=True)
        
        # LayerNorm 2 (用于Channel Mixer前)
        self.norm2 = nn.LayerNorm(in_channels)
        
        # Channel Mixer: MLP结构
        self.mlp = nn.Sequential(
            nn.Conv2d(in_channels, in_channels * 4, 1, bias=False),  # 扩展通道数
            nn.ReLU(inplace=True),
            nn.Conv2d(in_channels * 4, in_channels, 1, bias=False)  # 压缩回原始通道数
        )

    def forward(self, x):
        # 残差连接1的起点
        residual1 = x
        
        # LayerNorm 1
        out = x.permute(0, 2, 3, 1)  # (B, H, W, C) for LayerNorm
        out = self.norm1(out)
        out = out.permute(0, 3, 1, 2)  # (B, C, H, W)
        
        # Token Mixer: TopK Attention（替代原来的多尺度卷积）
        attention_weights = self.topk_attention(out)  # (B, C, H, W)
        attention_weights = torch.sigmoid(attention_weights)  # 归一化到0-1
        out = out * attention_weights  # 应用注意力权重
        
        # 归一化和激活
        if out.shape[2] > 1 and out.shape[3] > 1:
            out = self.topk_norm(out)
        out = self.topk_relu(out)
        
        # 残差连接1
        out = out + residual1
        
        # 残差连接2的起点
        residual2 = out
        
        # LayerNorm 2
        out = out.permute(0, 2, 3, 1)  # (B, H, W, C) for LayerNorm
        out = self.norm2(out)
        out = out.permute(0, 3, 1, 2)  # (B, C, H, W)
        
        # Channel Mixer: MLP
        out = self.mlp(out)
        
        # 残差连接2
        out = out + residual2

        return out


from attention import TransformerBlock

class TransformerAttention(nn.Module):
    """
    Transformer注意力包装器，用于适配TransformerBlock到CNN的输入输出格式
    输入：(B, C, H, W)
    输出：(B, C, H, W)
    """
    
    def __init__(self, in_channels, input_resolution=32, num_heads=8, win_size=8, shift_size=0,
                 mlp_ratio=4., qkv_bias=True, qk_scale=None, drop=0., attn_drop=0., drop_path=0.,
                 act_layer=nn.GELU, norm_layer=nn.LayerNorm, token_projection='linear', token_mlp='leff',
                 att=True, sparseAtt=False):
        super(TransformerAttention, self).__init__()
        
        # 将input_resolution转换为元组格式
        if isinstance(input_resolution, int):
            input_resolution = (input_resolution, input_resolution)
        
        # 创建TransformerBlock实例
        self.transformer = TransformerBlock(
            dim=in_channels,
            input_resolution=input_resolution,
            num_heads=num_heads,
            win_size=win_size,
            shift_size=shift_size,
            mlp_ratio=mlp_ratio,
            qkv_bias=qkv_bias,
            qk_scale=qk_scale,
            drop=drop,
            attn_drop=attn_drop,
            drop_path=drop_path,
            act_layer=act_layer,
            norm_layer=norm_layer,
            token_projection=token_projection,
            token_mlp=token_mlp,
            att=att,
            sparseAtt=sparseAtt
        )
    
    def forward(self, x):
        # 输入格式转换：(B, C, H, W) → (B, H*W, C)
        B, C, H, W = x.shape
        x = x.view(B, C, H*W).permute(0, 2, 1)  # (B, H*W, C)
        
        # TransformerBlock前向传播
        x = self.transformer(x)
        
        # 输出格式转换：(B, H*W, C) → (B, C, H, W)
        x = x.permute(0, 2, 1).view(B, C, H, W)
        
        return x


class DoubleConv(nn.Module):
    """
    新的DoubleConv模块：按照用户描述的架构设计
    - 输入 → 第一个残差加法节点（起点）
    - 路径1：LN + MultiScaleConvModule（内部包含TopK Attention） → 回到第一个残差加法节点
    - 路径2：LN + MLP → 第二个残差加法节点
    - 最终残差连接 → 输出
    注意：TopK Attention已经移动到MultiScaleConvModule内部作为Token Mixer
    """

    def __init__(self, in_channels, out_channels):
        super(DoubleConv, self).__init__()

        # 保存通道数信息
        self.in_channels = in_channels
        self.out_channels = out_channels

        # 如果输入输出通道不同，先调整通道数
        self.channel_adjust = nn.Conv2d(in_channels, out_channels, 1,
                                        bias=False) if in_channels != out_channels else None

        # 第一个残差路径：LN + 多尺度CNN（基于输出通道数）
        self.norm1 = nn.LayerNorm(out_channels)
        self.multi_scale = MultiScaleConvModule(out_channels)

        # 第二个残差路径：LN + MLP（基于输出通道数）
        self.norm2 = nn.LayerNorm(out_channels)
        # MLP：两个线性层，中间有激活函数
        self.mlp = nn.Sequential(
            nn.Conv2d(out_channels, out_channels * 4, 1, bias=False),  # 扩展通道数
            nn.ReLU(inplace=True),
            nn.Conv2d(out_channels * 4, out_channels, 1, bias=False)  # 压缩回原始通道数
        )
        
        # 注意：TopK Attention已经移动到MultiScaleConvModule内部，这里不再需要

    def forward(self, x, high_freq_feat=None):
        """
        Args:
            x: (B, C, H, W) - 输入特征
            high_freq_feat: (B, C, H, W) - 高频特征（可选，用于上采样过程中的topk部分）
        """
        # 如果输入输出通道不同，先调整通道数
        if self.channel_adjust is not None:
            x = self.channel_adjust(x)

        # 保存调整后的输入用于最终的残差连接
        residual_input = x

        # 第一个残差连接路径：LN + 多尺度CNN
        # 第一个残差加法节点（起点）
        residual1 = x

        # LN + 多尺度CNN路径
        out1 = x.permute(0, 2, 3, 1)  # (B, H, W, C) for LayerNorm
        out1 = self.norm1(out1)
        out1 = out1.permute(0, 3, 1, 2)  # (B, C, H, W)
        out1 = self.multi_scale(out1)

        # 回到第一个残差加法节点
        x = residual1 + out1

        # 第二个残差连接路径：LN + MLP
        residual2 = x

        # LN + MLP路径
        out2 = x.permute(0, 2, 3, 1)  # (B, H, W, C) for LayerNorm
        out2 = self.norm2(out2)
        out2 = out2.permute(0, 3, 1, 2)  # (B, C, H, W)
        out2 = self.mlp(out2)

        # 回到第二个残差加法节点
        x = residual2 + out2

        # 注意：TopK Attention已经在MultiScaleConvModule内部处理，这里不再需要
        # MultiScaleConvModule已经包含了TopK Attention作为Token Mixer

        # 最终的残差连接
        x = x + residual_input

        return x


class SimpleSkipConnection(nn.Module):
    """
    简单跳跃连接：拼接 + 1DCNN
    输入：编码器特征和解码器特征
    输出：融合后的特征
    """
    def __init__(self, in_channels):
        super(SimpleSkipConnection, self).__init__()
        # 拼接后通道数翻倍，使用1x1卷积降维
        self.conv1x1 = nn.Conv2d(in_channels * 2, in_channels, 1, bias=False)
        # 1DCNN：使用1x3和3x1卷积模拟1D卷积
        self.conv1d_1 = nn.Conv2d(in_channels, in_channels, (1, 3), padding=(0, 1), bias=False)
        self.conv1d_2 = nn.Conv2d(in_channels, in_channels, (3, 1), padding=(1, 0), bias=False)
        self.relu = nn.ReLU(inplace=True)
        
    def forward(self, enc_feat, dec_feat):
        # 拼接编码器和解码器特征
        combined = torch.cat([enc_feat, dec_feat], dim=1)
        # 1x1卷积降维
        out = self.conv1x1(combined)
        # 1DCNN处理
        out1 = self.conv1d_1(out)
        out2 = self.conv1d_2(out)
        out = out1 + out2
        out = self.relu(out)
        return out


class UNet_Deep(nn.Module):
    """
    改进的3层UNet：
    - 下采样：池化后DWT → A处理（低频）+ B处理（高频）
    - 上采样：DoubleConv处理 + topk使用高频处理结果
    """

    def __init__(self, in_channels=25, out_channels=25, num_filters=64):
        super(UNet_Deep, self).__init__()

        # 编码器（3层）
        self.enc1 = DoubleConv(in_channels, num_filters)
        # 删除池化下采样操作
        # 下采样后的DWT + A/B处理
        self.dwt1 = DWT()
        self.a_process1 = AProcess(num_filters)
        self.b_process1 = BProcess(num_filters)
        
        self.enc2 = DoubleConv(num_filters, num_filters * 2)
        # 删除池化下采样操作
        # 下采样后的DWT + A/B处理
        self.dwt2 = DWT()
        self.a_process2 = AProcess(num_filters * 2)
        self.b_process2 = BProcess(num_filters * 2)
        
        self.enc3 = DoubleConv(num_filters * 2, num_filters * 4)
        # 删除池化下采样操作
        # 下采样后的DWT + A/B处理
        self.dwt3 = DWT()
        self.a_process3 = AProcess(num_filters * 4)
        self.b_process3 = BProcess(num_filters * 4)

        # 瓶颈层
        self.bottleneck = DoubleConv(num_filters * 4, num_filters * 8)

        # 解码器（3层）- 改为 IWT 逆小波上采样
        self.iwt = IWT()
        # IWT 要求输入通道是目标通道的 4 倍
        self.up3_proj = nn.Conv2d(num_filters * 8, num_filters * 4 * 4, kernel_size=1, bias=False)
        self.dec3 = DoubleConv(num_filters * 4, num_filters * 4)  # 移到上采样

        self.up2_proj = nn.Conv2d(num_filters * 4, num_filters * 2 * 4, kernel_size=1, bias=False)
        self.dec2 = DoubleConv(num_filters * 2, num_filters * 2)  # 移到上采样

        self.up1_proj = nn.Conv2d(num_filters * 2, num_filters * 4, kernel_size=1, bias=False)
        self.dec1 = DoubleConv(num_filters, num_filters)  # 移到上采样

        # 输出层
        self.final_conv = nn.Conv2d(num_filters, out_channels, 1)

        # 跳跃连接模块（简单拼接 + 1DCNN）
        self.skip3 = SimpleSkipConnection(num_filters * 4)
        self.skip2 = SimpleSkipConnection(num_filters * 2)
        self.skip1 = SimpleSkipConnection(num_filters)
        
        # 存储高频特征用于上采样
        self.high_freq_features = {}

    def forward(self, x):
        # 初始化高频特征存储字典
        self.high_freq_features = {}
        
        # 编码器路径（3层）- 改进的下采样流程（删除池化操作）
        enc1 = self.enc1(x)
        
        # 直接使用enc1进行DWT + A/B处理（不再进行池化）
        x_LL1, x_HL1, x_LH1, x_HH1 = self.dwt1(enc1)
        high_freq1 = self.b_process1(x_HL1, x_LH1, x_HH1)  # B处理：高频融合
        low_freq1 = self.a_process1(x_LL1, high_freq1)  # A处理：低频处理（使用高频作为权重）
        # 存储高频特征用于上采样
        self.high_freq_features['level1'] = high_freq1
        
        enc2 = self.enc2(low_freq1)
        
        # 直接使用enc2进行DWT + A/B处理（不再进行池化）
        x_LL2, x_HL2, x_LH2, x_HH2 = self.dwt2(enc2)
        high_freq2 = self.b_process2(x_HL2, x_LH2, x_HH2)  # B处理
        low_freq2 = self.a_process2(x_LL2, high_freq2)  # A处理
        self.high_freq_features['level2'] = high_freq2
        
        enc3 = self.enc3(low_freq2)
        
        # 直接使用enc3进行DWT + A/B处理（不再进行池化）
        x_LL3, x_HL3, x_LH3, x_HH3 = self.dwt3(enc3)
        high_freq3 = self.b_process3(x_HL3, x_LH3, x_HH3)  # B处理
        low_freq3 = self.a_process3(x_LL3, high_freq3)  # A处理
        self.high_freq_features['level3'] = high_freq3

        # 瓶颈层
        bottleneck = self.bottleneck(low_freq3)

        # 解码器路径（3层）- 改进的上采样流程
        dec3 = self.iwt(self.up3_proj(bottleneck))
        if dec3.shape[2:] != low_freq3.shape[2:]:
            dec3 = F.interpolate(dec3, size=low_freq3.shape[2:], mode='bilinear', align_corners=False)
        # 使用简单跳跃连接融合编码器和解码器特征
        fused3 = self.skip3(low_freq3, dec3)
        # DoubleConv移到上采样过程，并在topk部分使用高频处理结果
        dec3 = self.dec3(fused3, high_freq_feat=self.high_freq_features['level3'])

        dec2 = self.iwt(self.up2_proj(dec3))
        if dec2.shape[2:] != low_freq2.shape[2:]:
            dec2 = F.interpolate(dec2, size=low_freq2.shape[2:], mode='bilinear', align_corners=False)
        # 使用简单跳跃连接融合编码器和解码器特征
        fused2 = self.skip2(low_freq2, dec2)
        dec2 = self.dec2(fused2, high_freq_feat=self.high_freq_features['level2'])

        dec1 = self.iwt(self.up1_proj(dec2))
        if dec1.shape[2:] != low_freq1.shape[2:]:
            dec1 = F.interpolate(dec1, size=low_freq1.shape[2:], mode='bilinear', align_corners=False)
        # 使用简单跳跃连接融合编码器和解码器特征
        fused1 = self.skip1(low_freq1, dec1)
        dec1 = self.dec1(fused1, high_freq_feat=self.high_freq_features['level1'])

        # 输出层
        out = self.final_conv(dec1)

        # 如果输出尺寸与输入不匹配，进行插值
        if out.shape[2:] != x.shape[2:]:
            out = F.interpolate(out, size=x.shape[2:], mode='bilinear', align_corners=False)

        return out


def create_gaussian_weight_matrix(size=13, sigma=None):
    """
    创建二维高斯权重矩阵

    Args:
        size: 矩阵大小（默认13×13）
        sigma: 高斯函数的标准差，如果为None则使用size/6作为默认值

    Returns:
        gaussian_matrix: (size, size)的numpy数组，中心值最大，边缘值最小
    """
    if sigma is None:
        sigma = size / 6.0  # 默认sigma，使得边缘值约为中心的1%

    # 创建坐标网格
    center = (size - 1) / 2.0
    x = np.arange(size) - center
    y = np.arange(size) - center
    X, Y = np.meshgrid(x, y)

    # 计算二维高斯函数
    gaussian_matrix = np.exp(-(X ** 2 + Y ** 2) / (2 * sigma ** 2))

    # 归一化，使得中心值为1
    gaussian_matrix = gaussian_matrix / gaussian_matrix.max()

    return gaussian_matrix


class UNet(nn.Module):
    """
    3层UNet
    在输入前应用高斯权重
    """

    def __init__(self, in_channels=30, out_channels=30, num_filters=64, patch_size=16):
        super(UNet, self).__init__()

        # 深层UNet（3层）
        self.deep_unet = UNet_Deep(
            in_channels=in_channels,
            out_channels=out_channels,
            num_filters=num_filters
        )

        # 创建高斯权重矩阵（注册为buffer，不参与训练但会随模型保存）
        gaussian_weight = create_gaussian_weight_matrix(size=patch_size)
        # 转换为torch tensor并注册为buffer
        self.register_buffer('gaussian_weight', torch.FloatTensor(gaussian_weight))

        # 保存输出通道数用于兼容性
        self.out_channels = out_channels

        # 为了兼容性，保留stage_out属性
        class StageOutWrapper(nn.Module):
            def __init__(self, out_channels):
                super().__init__()
                self.out_channels = out_channels

            def forward(self, x):
                return x

        self.stage_out = StageOutWrapper(out_channels)

    def forward(self, x):
        """
        Args:
            x: 输入特征图 (B, C, H, W)
        Returns:
            out: 输出特征图 (B, out_channels, H, W)
        """
        # 应用高斯权重：对每个通道都乘以高斯权重矩阵
        # x形状: (B, C, H, W)
        # gaussian_weight形状: (H, W) 或 (patch_size, patch_size)
        # 使用广播机制：(B, C, H, W) * (1, 1, H, W) -> (B, C, H, W)
        gaussian_weight = self.gaussian_weight.unsqueeze(0).unsqueeze(0)  # (1, 1, H, W)
        x_weighted = x * gaussian_weight

        # 深层UNet特征提取
        out = self.deep_unet(x_weighted)

        return out

