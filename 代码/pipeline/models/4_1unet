import torch
import torch.nn as nn
import torch.nn.functional as F
import numpy as np
import math
from einops import repeat
from mamba_ssm.ops.selective_scan_interface import selective_scan_fn

# ==================== DWT/IWT 模块（从Wave-Mamba提取）====================

def dwt_init(x):
    """小波变换：将输入分解为4个子带"""
    x01 = x[:, :, 0::2, :] / 2
    x02 = x[:, :, 1::2, :] / 2
    x1 = x01[:, :, :, 0::2]
    x2 = x02[:, :, :, 0::2]
    x3 = x01[:, :, :, 1::2]
    x4 = x02[:, :, :, 1::2]
    x_LL = x1 + x2 + x3 + x4
    x_HL = -x1 - x2 + x3 + x4
    x_LH = -x1 + x2 - x3 + x4
    x_HH = x1 - x2 - x3 + x4
    return x_LL, x_HL, x_LH, x_HH


def iwt_init(x):
    """逆小波变换：将4个子带合并为原图"""
    r = 2
    in_batch, in_channel, in_height, in_width = x.size()
    out_batch = in_batch
    out_channel = int(in_channel / (r ** 2))
    out_height = r * in_height
    out_width = r * in_width

    x1 = x[:, :out_channel, :, :] / 2
    x2 = x[:, out_channel:out_channel * 2, :, :] / 2
    x3 = x[:, out_channel * 2:out_channel * 3, :, :] / 2
    x4 = x[:, out_channel * 3:out_channel * 4, :, :] / 2

    h = torch.zeros([out_batch, out_channel, out_height, out_width], dtype=x.dtype, device=x.device)
    h[:, :, 0::2, 0::2] = x1 - x2 - x3 + x4
    h[:, :, 1::2, 0::2] = x1 - x2 + x3 - x4
    h[:, :, 0::2, 1::2] = x1 + x2 - x3 - x4
    h[:, :, 1::2, 1::2] = x1 + x2 + x3 + x4
    return h


class DWT(nn.Module):
    """离散小波变换模块"""
    def __init__(self):
        super(DWT, self).__init__()
        self.requires_grad = False  

    def forward(self, x):
        return dwt_init(x)


class IWT(nn.Module):
    """逆小波变换模块"""
    def __init__(self):
        super(IWT, self).__init__()
        self.requires_grad = False

    def forward(self, x):
        return iwt_init(x)


# ==================== A处理模块：空间Mamba + 光谱Mamba ====================

class SS1D(nn.Module):
    """
    1D Selective Scan State Space Model (Mamba)
    适用于1D序列数据的Mamba实现
    """
    def __init__(
            self,
            d_model,
            d_state=16,
            d_conv=3,
            expand=2,
            dt_rank="auto",
            dt_min=0.001,
            dt_max=0.1,
            dt_init="random",
            dt_scale=1.0,
            dt_init_floor=1e-4,
            dropout=0.,
            conv_bias=True,
            bias=False,
            device=None,
            dtype=None,
            **kwargs,
    ):
        factory_kwargs = {"device": device, "dtype": dtype}
        super().__init__()
        self.d_model = d_model
        self.d_state = d_state
        self.d_conv = d_conv
        self.expand = expand
        self.d_inner = int(self.expand * self.d_model)
        self.dt_rank = math.ceil(self.d_model / 16) if dt_rank == "auto" else dt_rank

        self.in_proj = nn.Linear(self.d_model, self.d_inner * 2, bias=bias, **factory_kwargs)
        # 1D卷积（用于序列数据）
        self.conv1d = nn.Conv1d(
            in_channels=self.d_inner,
            out_channels=self.d_inner,
            groups=self.d_inner,
            bias=conv_bias,
            kernel_size=d_conv,
            padding=(d_conv - 1) // 2,
            **factory_kwargs,
        )
        self.act = nn.SiLU()

        # 1D只需要一个方向的投影（而不是2D的4个方向）
        self.x_proj = nn.Linear(self.d_inner, (self.dt_rank + self.d_state * 2), bias=False, **factory_kwargs)

        self.dt_proj = self.dt_init(self.dt_rank, self.d_inner, dt_scale, dt_init, dt_min, dt_max, dt_init_floor,
                                     **factory_kwargs)
        self.dt_projs_weight = nn.Parameter(self.dt_proj.weight)
        self.dt_projs_bias = nn.Parameter(self.dt_proj.bias)
        del self.dt_proj

        self.A_logs = self.A_log_init(self.d_state, self.d_inner, copies=1, merge=True)  # (D, N)
        self.Ds = self.D_init(self.d_inner, copies=1, merge=True)  # (D, N)

        self.selective_scan = selective_scan_fn

        self.out_norm = nn.LayerNorm(self.d_inner)
        self.out_proj = nn.Linear(self.d_inner, self.d_model, bias=bias, **factory_kwargs)
        self.dropout = nn.Dropout(dropout) if dropout > 0. else None

    @staticmethod
    def dt_init(dt_rank, d_inner, dt_scale=1.0, dt_init="random", dt_min=0.001, dt_max=0.1, dt_init_floor=1e-4,
                **factory_kwargs):
        dt_proj = nn.Linear(dt_rank, d_inner, bias=True, **factory_kwargs)

        # Initialize special dt projection to preserve variance at initialization
        dt_init_std = dt_rank ** -0.5 * dt_scale
        if dt_init == "constant":
            nn.init.constant_(dt_proj.weight, dt_init_std)
        elif dt_init == "random":
            nn.init.uniform_(dt_proj.weight, -dt_init_std, dt_init_std)
        else:
            raise NotImplementedError

        # Initialize dt bias so that F.softplus(dt_bias) is between dt_min and dt_max
        dt = torch.exp(
            torch.rand(d_inner, **factory_kwargs) * (math.log(dt_max) - math.log(dt_min))
            + math.log(dt_min)
        ).clamp(min=dt_init_floor)
        # Inverse of softplus: https://github.com/pytorch/pytorch/issues/72759
        inv_dt = dt + torch.log(-torch.expm1(-dt))
        with torch.no_grad():
            dt_proj.bias.copy_(inv_dt)
        # Our initialization would set all Linear.bias to zero, need to mark this one as _no_reinit
        dt_proj.bias._no_reinit = True

        return dt_proj

    @staticmethod
    def A_log_init(d_state, d_inner, copies=1, device=None, merge=True):
        # S4D real initialization
        A = repeat(
            torch.arange(1, d_state + 1, dtype=torch.float32, device=device),
            "n -> d n",
            d=d_inner,
        ).contiguous()
        A_log = torch.log(A)  # Keep A_log in fp32
        if copies > 1:
            A_log = repeat(A_log, "d n -> r d n", r=copies)
            if merge:
                A_log = A_log.flatten(0, 1)
        A_log = nn.Parameter(A_log)
        A_log._no_weight_decay = True
        return A_log

    @staticmethod
    def D_init(d_inner, copies=1, device=None, merge=True):
        # D "skip" parameter
        D = torch.ones(d_inner, device=device)
        if copies > 1:
            D = repeat(D, "n1 -> r n1", r=copies)
            if merge:
                D = D.flatten(0, 1)
        D = nn.Parameter(D)  # Keep in fp32
        D._no_weight_decay = True
        return D

    def forward(self, x: torch.Tensor, **kwargs):
        """
        Args:
            x: (B, L, C) - 输入序列，L是序列长度，C是特征维度
        Returns:
            out: (B, L, C) - 输出序列
        """
        B, L, C = x.shape

        # 输入投影
        xz = self.in_proj(x)  # (B, L, d_inner * 2)
        x, z = xz.chunk(2, dim=-1)  # 每个都是 (B, L, d_inner)

        # 转换为 (B, d_inner, L) 用于1D卷积
        x = x.permute(0, 2, 1).contiguous()  # (B, d_inner, L)
        x = self.act(self.conv1d(x))  # (B, d_inner, L)
        
        # 转换回 (B, L, d_inner) 用于selective scan
        x = x.permute(0, 2, 1).contiguous()  # (B, L, d_inner)

        # 投影得到 dt, B, C
        x_dbl = self.x_proj(x)  # (B, L, dt_rank + d_state * 2)
        dts, Bs, Cs = torch.split(x_dbl, [self.dt_rank, self.d_state, self.d_state], dim=-1)
        
        # 计算dt
        dts = F.linear(dts, self.dt_projs_weight, self.dt_projs_bias)  # (B, L, d_inner)

        # 准备selective scan的输入
        # 需要将 (B, L, d_inner) 转换为 (B, d_inner, L) 用于selective_scan
        xs = x.float().transpose(1, 2)  # (B, d_inner, L)
        dts = dts.float().transpose(1, 2)  # (B, d_inner, L)
        Bs = Bs.float().transpose(1, 2)  # (B, d_state, L)
        Cs = Cs.float().transpose(1, 2)  # (B, d_state, L)
        
        # 扩展维度以匹配selective_scan的输入格式
        # selective_scan期望: (batch, dim, seqlen) 或 (batch, dim, seqlen) 格式
        # 对于1D，我们需要添加一个K维度（K=1）
        xs = xs.unsqueeze(1)  # (B, 1, d_inner, L)
        dts = dts.unsqueeze(1)  # (B, 1, d_inner, L)
        Bs = Bs.unsqueeze(1)  # (B, 1, d_state, L)
        Cs = Cs.unsqueeze(1)  # (B, 1, d_state, L)
        
        # 重塑为selective_scan期望的格式
        xs = xs.view(B, -1, L)  # (B, d_inner, L)
        dts = dts.view(B, -1, L)  # (B, d_inner, L)
        Bs = Bs.view(B, 1, -1, L)  # (B, 1, d_state, L)
        Cs = Cs.view(B, 1, -1, L)  # (B, 1, d_state, L)
        
        Ds = self.Ds.float().view(-1)  # (d_inner,)
        As = -torch.exp(self.A_logs.float()).view(-1, self.d_state)  # (d_inner, d_state)
        dt_projs_bias = self.dt_projs_bias.float().view(-1)  # (d_inner,)

        # 调用selective_scan
        # 注意：selective_scan期望的格式可能需要调整
        # 我们需要将Bs和Cs重塑为正确的格式
        out_y = self.selective_scan(
            xs, dts,
            As, Bs, Cs, Ds, z=None,
            delta_bias=dt_projs_bias,
            delta_softplus=True,
            return_last_state=False,
        )  # (B, d_inner, L)
        
        assert out_y.dtype == torch.float

        # 转换回 (B, L, d_inner)
        y = out_y.transpose(1, 2).contiguous()  # (B, L, d_inner)
        
        # 归一化
        y = self.out_norm(y)
        
        # 门控机制
        y = y * F.silu(z)
        
        # 输出投影
        out = self.out_proj(y)  # (B, L, C)
        
        if self.dropout is not None:
            out = self.dropout(out)
        
        return out


class SS2D(nn.Module):
    """
    完整的2D SSM实现（使用mamba_ssm库）
    从Wave-Mamba中提取的完整SS2D实现
    """
    def __init__(
            self,
            d_model,
            d_state=16,
            d_conv=3,
            expand=2,
            dt_rank="auto",
            dt_min=0.001,
            dt_max=0.1,
            dt_init="random",
            dt_scale=1.0,
            dt_init_floor=1e-4,
            dropout=0.,
            conv_bias=True,
            bias=False,
            device=None,
            dtype=None,
            **kwargs,
    ):
        factory_kwargs = {"device": device, "dtype": dtype}
        super().__init__()
        self.d_model = d_model
        self.d_state = d_state
        self.d_conv = d_conv
        self.expand = expand
        self.d_inner = int(self.expand * self.d_model)
        self.dt_rank = math.ceil(self.d_model / 16) if dt_rank == "auto" else dt_rank

        self.in_proj = nn.Linear(self.d_model, self.d_inner * 2, bias=bias, **factory_kwargs)
        self.conv2d = nn.Conv2d(
            in_channels=self.d_inner,
            out_channels=self.d_inner,
            groups=self.d_inner,
            bias=conv_bias,
            kernel_size=d_conv,
            padding=(d_conv - 1) // 2,
            **factory_kwargs,
        )
        self.act = nn.SiLU()

        self.x_proj = (
            nn.Linear(self.d_inner, (self.dt_rank + self.d_state * 2), bias=False, **factory_kwargs),
            nn.Linear(self.d_inner, (self.dt_rank + self.d_state * 2), bias=False, **factory_kwargs),
            nn.Linear(self.d_inner, (self.dt_rank + self.d_state * 2), bias=False, **factory_kwargs),
            nn.Linear(self.d_inner, (self.dt_rank + self.d_state * 2), bias=False, **factory_kwargs),
        )
        self.x_proj_weight = nn.Parameter(torch.stack([t.weight for t in self.x_proj], dim=0))  # (K=4, N, inner)
        del self.x_proj

        self.dt_projs = (
            self.dt_init(self.dt_rank, self.d_inner, dt_scale, dt_init, dt_min, dt_max, dt_init_floor,
                         **factory_kwargs),
            self.dt_init(self.dt_rank, self.d_inner, dt_scale, dt_init, dt_min, dt_max, dt_init_floor,
                         **factory_kwargs),
            self.dt_init(self.dt_rank, self.d_inner, dt_scale, dt_init, dt_min, dt_max, dt_init_floor,
                         **factory_kwargs),
            self.dt_init(self.dt_rank, self.d_inner, dt_scale, dt_init, dt_min, dt_max, dt_init_floor,
                         **factory_kwargs),
        )
        self.dt_projs_weight = nn.Parameter(torch.stack([t.weight for t in self.dt_projs], dim=0))  # (K=4, inner, rank)
        self.dt_projs_bias = nn.Parameter(torch.stack([t.bias for t in self.dt_projs], dim=0))  # (K=4, inner)
        del self.dt_projs

        self.A_logs = self.A_log_init(self.d_state, self.d_inner, copies=4, merge=True)  # (K=4, D, N)
        self.Ds = self.D_init(self.d_inner, copies=4, merge=True)  # (K=4, D, N)

        self.selective_scan = selective_scan_fn

        self.out_norm = nn.LayerNorm(self.d_inner)
        self.out_proj = nn.Linear(self.d_inner, self.d_model, bias=bias, **factory_kwargs)
        self.dropout = nn.Dropout(dropout) if dropout > 0. else None

    @staticmethod
    def dt_init(dt_rank, d_inner, dt_scale=1.0, dt_init="random", dt_min=0.001, dt_max=0.1, dt_init_floor=1e-4,
                **factory_kwargs):
        dt_proj = nn.Linear(dt_rank, d_inner, bias=True, **factory_kwargs)

        # Initialize special dt projection to preserve variance at initialization
        dt_init_std = dt_rank ** -0.5 * dt_scale
        if dt_init == "constant":
            nn.init.constant_(dt_proj.weight, dt_init_std)
        elif dt_init == "random":
            nn.init.uniform_(dt_proj.weight, -dt_init_std, dt_init_std)
        else:
            raise NotImplementedError

        # Initialize dt bias so that F.softplus(dt_bias) is between dt_min and dt_max
        dt = torch.exp(
            torch.rand(d_inner, **factory_kwargs) * (math.log(dt_max) - math.log(dt_min))
            + math.log(dt_min)
        ).clamp(min=dt_init_floor)
        # Inverse of softplus: https://github.com/pytorch/pytorch/issues/72759
        inv_dt = dt + torch.log(-torch.expm1(-dt))
        with torch.no_grad():
            dt_proj.bias.copy_(inv_dt)
        # Our initialization would set all Linear.bias to zero, need to mark this one as _no_reinit
        dt_proj.bias._no_reinit = True

        return dt_proj

    @staticmethod
    def A_log_init(d_state, d_inner, copies=1, device=None, merge=True):
        # S4D real initialization
        A = repeat(
            torch.arange(1, d_state + 1, dtype=torch.float32, device=device),
            "n -> d n",
            d=d_inner,
        ).contiguous()
        A_log = torch.log(A)  # Keep A_log in fp32
        if copies > 1:
            A_log = repeat(A_log, "d n -> r d n", r=copies)
            if merge:
                A_log = A_log.flatten(0, 1)
        A_log = nn.Parameter(A_log)
        A_log._no_weight_decay = True
        return A_log

    @staticmethod
    def D_init(d_inner, copies=1, device=None, merge=True):
        # D "skip" parameter
        D = torch.ones(d_inner, device=device)
        if copies > 1:
            D = repeat(D, "n1 -> r n1", r=copies)
            if merge:
                D = D.flatten(0, 1)
        D = nn.Parameter(D)  # Keep in fp32
        D._no_weight_decay = True
        return D

    def forward_core(self, x: torch.Tensor):
        B, C, H, W = x.shape
        L = H * W
        K = 4

        x_hwwh = torch.stack([x.view(B, -1, L), torch.transpose(x, dim0=2, dim1=3).contiguous().view(B, -1, L)], dim=1).view(B, 2, -1, L)
        xs = torch.cat([x_hwwh, torch.flip(x_hwwh, dims=[-1])], dim=1) # (B, 4, d_inner, L)
        x_dbl = torch.einsum("b k d l, k c d -> b k c l", xs.view(B, K, -1, L), self.x_proj_weight)
        dts, Bs, Cs = torch.split(x_dbl, [self.dt_rank, self.d_state, self.d_state], dim=2)
        dts = torch.einsum("b k r l, k d r -> b k d l", dts.view(B, K, -1, L), self.dt_projs_weight)

        xs = xs.float().view(B, -1, L)
        dts = dts.contiguous().float().view(B, -1, L) # (b, k * d, l)
        Bs = Bs.float().view(B, K, -1, L)
        Cs = Cs.float().view(B, K, -1, L) # (b, k, d_state, l)
        Ds = self.Ds.float().view(-1)
        As = -torch.exp(self.A_logs.float()).view(-1, self.d_state)
        dt_projs_bias = self.dt_projs_bias.float().view(-1) # (k * d)

        out_y = self.selective_scan(
            xs, dts,
            As, Bs, Cs, Ds, z=None,
            delta_bias=dt_projs_bias,
            delta_softplus=True,
            return_last_state=False,
        ).view(B, K, -1, L)
        assert out_y.dtype == torch.float

        inv_y = torch.flip(out_y[:, 2:4], dims=[-1]).view(B, 2, -1, L)
        wh_y = torch.transpose(out_y[:, 1].view(B, -1, W, H), dim0=2, dim1=3).contiguous().view(B, -1, L)
        invwh_y = torch.transpose(inv_y[:, 1].view(B, -1, W, H), dim0=2, dim1=3).contiguous().view(B, -1, L)

        return out_y[:, 0], inv_y[:, 0], wh_y, invwh_y

    def forward(self, x: torch.Tensor, **kwargs):
        """
        Args:
            x: (B, H, W, C) - 输入特征图
        Returns:
            out: (B, H, W, C) - 输出特征图
        """
        B, H, W, C = x.shape

        xz = self.in_proj(x)
        x, z = xz.chunk(2, dim=-1)

        x = x.permute(0, 3, 1, 2).contiguous()
        x = self.act(self.conv2d(x))
        y1, y2, y3, y4 = self.forward_core(x)
        assert y1.dtype == torch.float32
        y = y1 + y2 + y3 + y4
        y = torch.transpose(y, dim0=1, dim1=2).contiguous().view(B, H, W, -1)
        y = self.out_norm(y)
        y = y * F.silu(z)
        out = self.out_proj(y)
        if self.dropout is not None:
            out = self.dropout(out)
        return out


class SpatialMamba2D(nn.Module):
    """
    空间Mamba（2D SSM）完整实现
    结构：input → linear → LN → 2dSSM → GN → Relu → output
    残差：input → Linear → output
    """
    def __init__(self, dim, d_state=16, d_conv=3, expand=2):
        super().__init__()
        self.dim = dim
        self.d_inner = int(expand * dim)
        
        # Linear projection
        self.linear = nn.Linear(dim, self.d_inner)
        
        # LayerNorm
        self.ln = nn.LayerNorm(self.d_inner)
        
        # 完整的2D SSM（使用mamba_ssm）
        self.ss2d = SS2D(
            d_model=self.d_inner,
            d_state=d_state,
            d_conv=d_conv,
            expand=1,  # SS2D内部已经expand了，这里保持为1
            dropout=0.
        )
        
        # GroupNorm
        self.gn = nn.GroupNorm(num_groups=min(32, self.d_inner), num_channels=self.d_inner)
        
        # ReLU
        self.relu = nn.ReLU(inplace=True)
        
        # 残差连接的Linear
        self.residual_linear = nn.Linear(dim, self.d_inner)
        
        # 输出投影
        self.out_proj = nn.Linear(self.d_inner, dim)
    
    def forward(self, x):
        """
        Args:
            x: (B, H, W, C) - 输入应该是 (B, H, W, C) 格式（由AProcess保证）
        Returns:
            out: (B, C, H, W)
        """
        # 检查并确保输入格式为 (B, H, W, C)
        if len(x.shape) == 4:
            # 检查最后一个维度是否是通道数
            if x.shape[-1] == self.dim:
                # 最后一个维度是通道数，已经是 (B, H, W, C) 格式
                pass
            elif x.shape[1] == self.dim:
                # 第一个非batch维度是通道数，是 (B, C, H, W) 格式，需要转换
                x = x.permute(0, 2, 3, 1)
            else:
                # 无法确定格式，抛出错误
                raise ValueError(
                    f"[SpatialMamba2D] 无法确定输入格式: {x.shape}, "
                    f"期望通道数: {self.dim}, "
                    f"但最后一个维度是: {x.shape[-1]}, 第一个非batch维度是: {x.shape[1]}"
                )
        
        B, H, W, C = x.shape
        
        # 验证通道数是否正确
        if C != self.dim:
            raise ValueError(
                f"[SpatialMamba2D] 通道数不匹配: 期望 {self.dim}, 但得到 {C}. "
                f"输入形状: {x.shape}. "
                f"请检查输入数据的通道数是否正确。"
            )
        
        residual = x
        
        # Linear projection
        x = self.linear(x)  # (B, H, W, d_inner)
        
        # LayerNorm
        x = self.ln(x)
        
        # 完整的2D SSM处理
        x = self.ss2d(x)  # (B, H, W, d_inner)
        
        # GroupNorm (需要转换为 (B, C, H, W))
        x = x.permute(0, 3, 1, 2)  # (B, d_inner, H, W)
        x = self.gn(x)
        x = x.permute(0, 2, 3, 1)  # (B, H, W, d_inner)
        
        # ReLU
        x = self.relu(x)
        
        # 残差连接
        residual_proj = self.residual_linear(residual)  # (B, H, W, d_inner)
        x = x + residual_proj
        
        # 输出投影
        x = self.out_proj(x)  # (B, H, W, C)
        
        # 转换为 (B, C, H, W)
        x = x.permute(0, 3, 1, 2)
        
        return x


class SpectralMamba(nn.Module):
    """
    光谱Mamba：输入高频子带的混合结果，作为权重与空间mamba做乘法
    完善版本：对全局池化后的结果接入Mamba块，然后再对输出进行处理
    """
    def __init__(self, dim, d_state=16, d_conv=3, expand=2):
        super().__init__()
        self.dim = dim
        self.d_inner = int(expand * dim)
        
        # 输入投影：将 (B, C) 投影到 (B, C, dim) 以匹配SS1D的输入格式
        # 将每个通道作为一个时间步，序列长度L=C，特征维度为dim
        self.input_proj = nn.Linear(1, dim)  # 将标量特征投影到dim维
        
        # 全局池化后的1D Mamba块
        # 使用SS1D处理1D序列数据（光谱维度）
        # 输入格式：(B, C, dim)，其中C是序列长度（通道数），dim是特征维度
        self.mamba_block = SS1D(
            d_model=dim,
            d_state=d_state,
            d_conv=d_conv,
            expand=1,  # SS1D内部已经expand了
            dropout=0.
        )
        
        # Mamba块后的归一化和激活
        self.mamba_norm = nn.LayerNorm(dim)
        self.mamba_act = nn.GELU()
        
        # 线性门控单元（GLU - Gated Linear Unit）
        # 将输入投影到2倍维度，然后分成两部分：一部分作为值，一部分作为门控
        self.gate_proj = nn.Linear(dim, dim * 2)
        self.gate_act = nn.Sigmoid()  # 门控激活函数
        
        # 输出投影：将SS1D的输出 (B, C, dim) 投影回 (B, C)
        self.output_proj = nn.Linear(dim, 1)
    
    def forward(self, x):
        """
        Args:
            x: (B, C, H, W) - 高频子带的混合结果
        Returns:
            weights: (B, C, H, W) - 权重矩阵
        """
        B, C, H, W = x.shape
        
        # 全局平均池化得到通道特征
        x_global = F.adaptive_avg_pool2d(x, 1)  # (B, C, 1, 1)
        x_global = x_global.squeeze(-1).squeeze(-1)  # (B, C)
        
        # 将 (B, C) 转换为 (B, C, dim) 格式以使用SS1D Mamba块
        # 将每个通道作为一个时间步，序列长度L=C，特征维度为dim
        # 首先将 (B, C) -> (B, C, 1)，然后投影到 (B, C, dim)
        x_global_expanded = x_global.unsqueeze(-1)  # (B, C, 1)
        x_mamba_input = self.input_proj(x_global_expanded)  # (B, C, dim)
        # SS1D期望 (B, L, C) 格式，其中L是序列长度，C是特征维度d_model
        # 当前x_mamba_input是 (B, C_channels, dim)，需要转换为 (B, C_channels, dim)
        # 这正好符合SS1D的输入格式要求（L=C_channels, C=dim）
        
        # 通过1D Mamba块处理
        x_mamba = self.mamba_block(x_mamba_input)  # (B, C, dim)
        
        # 归一化和激活
        x_mamba = self.mamba_norm(x_mamba)
        x_mamba = self.mamba_act(x_mamba)
        
        # 线性门控单元（GLU）
        # 投影到2倍维度
        gate_output = self.gate_proj(x_mamba)  # (B, C, dim * 2)
        # 分成两部分：值和门控
        value, gate = gate_output.chunk(2, dim=-1)  # 每个都是 (B, C, dim)
        # 门控信号经过sigmoid激活
        gate = self.gate_act(gate)  # (B, C, dim)
        # 门控机制：值 * 门控
        x_mamba = value * gate  # (B, C, dim)
        
        # 输出投影：将 (B, C, dim) 投影回 (B, C, 1)，然后squeeze得到 (B, C)
        x_mamba = self.output_proj(x_mamba)  # (B, C, 1)
        x_mamba = x_mamba.squeeze(-1)  # (B, C)
        
        # 应用sigmoid生成权重
        weights = torch.sigmoid(x_mamba)  # (B, C)
        weights = weights.unsqueeze(-1).unsqueeze(-1)  # (B, C, 1, 1)
        
        # 广播到空间维度
        weights = weights.expand(-1, -1, H, W)
        
        return weights


class MultiScaleConvWithResidual(nn.Module):
    """
    多尺度卷积模块（仅卷积部分，带残差连接）
    从MultiScaleConvModule中提取的多尺度卷积部分，不包括LayerNorm和MLP
    """
    def __init__(self, in_channels):
        super(MultiScaleConvWithResidual, self).__init__()
        
        # Token Mixer: 多尺度卷积模块
        # 初始空洞卷积
        self.dilated_conv = nn.Conv2d(in_channels, in_channels, 3, padding=2, dilation=2, bias=False)
        self.relu = nn.ReLU(inplace=True)

        # 三个不同尺度的带状深度分离卷积（不同膨胀率）
        self.scale1 = nn.Sequential(
            nn.Conv2d(in_channels, in_channels, 3, padding=1, groups=in_channels, bias=False),  # 膨胀率1
            nn.Conv2d(in_channels, in_channels, 1, bias=False),
            nn.ReLU(inplace=True)
        )

        self.scale2 = nn.Sequential(
            nn.Conv2d(in_channels, in_channels, 3, padding=3, groups=in_channels, dilation=3, bias=False),  # 膨胀率3
            nn.Conv2d(in_channels, in_channels, 1, bias=False),
            nn.ReLU(inplace=True)
        )

        self.scale3 = nn.Sequential(
            nn.Conv2d(in_channels, in_channels, 3, padding=5, groups=in_channels, dilation=5, bias=False),  # 膨胀率5
            nn.Conv2d(in_channels, in_channels, 1, bias=False),
            nn.ReLU(inplace=True)
        )

        # 输出卷积
        self.output_conv = nn.Conv2d(in_channels * 3, in_channels, 1, bias=False)
        
        # BatchNorm和ReLU（替代原来的CBR中的BN和ReLU）
        self.bn = nn.BatchNorm2d(in_channels)
        self.final_relu = nn.ReLU(inplace=True)

    def forward(self, x):
        # 残差连接的起点
        residual = x
        
        # 多尺度卷积
        # 初始空洞卷积
        out = self.dilated_conv(x)
        out = self.relu(out)

        # 三个不同尺度的带状深度分离卷积并联
        out1 = self.scale1(out)
        out2 = self.scale2(out)
        out3 = self.scale3(out)

        # 拼接三个尺度的输出
        combined = torch.cat([out1, out2, out3], dim=1)

        # 输出卷积降维
        out = self.output_conv(combined)
        
        # BatchNorm和ReLU
        out = self.bn(out)
        out = self.final_relu(out)
        
        # 残差连接
        out = out + residual
        
        return out


class AProcess(nn.Module):
    """
    A处理模块：
    input → CBR（使用多尺度卷积替代） → tokenization_fn(Conv2d C->2C->C + Dropout 得到 y)
          → 空间mamba(y) 与 光谱mamba(y) → concat + 卷积融合
    input → output (残差)
    """
    def __init__(self, dim, d_state=16, d_conv=3, expand=2):
        super().__init__()
        self.dim = dim
        
        # CBR: 使用多尺度卷积模块（仅卷积部分，带残差）替代原来的卷积
        self.cbr = MultiScaleConvWithResidual(dim)

        # tokenization 前处理函数：
        # 先将通道从 C 提升到 2C，再投影回 C，最后 Dropout 得到新的特征图 y
        self.tokenization_fn = nn.Sequential(
            nn.Conv2d(dim, dim * 2, kernel_size=3, padding=1, bias=False),
            nn.BatchNorm2d(dim * 2),
            nn.ReLU(inplace=True),
            nn.Conv2d(dim * 2, dim, kernel_size=3, padding=1, bias=False),
            nn.BatchNorm2d(dim),
            nn.ReLU(inplace=True),
            nn.Dropout2d(p=0.1),
        )
        
        # 空间Mamba
        self.spatial_mamba = SpatialMamba2D(dim, d_state=d_state, d_conv=d_conv, expand=expand)
        
        # 光谱Mamba
        self.spectral_mamba = SpectralMamba(dim, d_state=d_state, d_conv=d_conv, expand=expand)
        
        # 融合卷积：将concat后的特征（2*dim通道）融合回dim通道
        self.fusion_conv = nn.Sequential(
            nn.Conv2d(dim * 2, dim, kernel_size=1, bias=False),
            nn.BatchNorm2d(dim),
            nn.ReLU(inplace=True)
        )
    
    def forward(self, x, high_freq_feat):
        """
        Args:
            x: (B, C, H, W) - 低频子带
            high_freq_feat: (B, C, H, W) - B处理的高频子带混合结果（不再使用）
        Returns:
            out: (B, C, H, W)
        """
        residual = x
        
        # CBR（使用多尺度卷积）
        cbr_output = self.cbr(x)  # (B, C, H, W)
        # 进入mamba前做 tokenization 前处理，得到新的特征图 y
        y = self.tokenization_fn(cbr_output)  # (B, C, H, W)
        
        # y 进行正常 tokenization（维度重排）后输入空间Mamba
        x = y.permute(0, 2, 3, 1)  # (B, H, W, C)
        
        # 空间Mamba
        spatial_output = self.spatial_mamba(x)  # 返回 (B, C, H, W)
        
        # 光谱Mamba使用同一个 y
        spectral_output = self.spectral_mamba(y)  # (B, C, H, W)
        
        # Concat + 卷积融合（替代原来的直接相乘）
        x = torch.cat([spatial_output, spectral_output], dim=1)  # (B, 2*C, H, W)
        x = self.fusion_conv(x)  # (B, C, H, W)
        
        # 残差连接
        out = x + residual
        
        return out
